# Copy to .env and fill in. The systemd unit loads this via EnvironmentFile.

# subscription = inherited Claude Code Pro OAuth (Phase 0 must pass)
# api-key      = set ANTHROPIC_API_KEY below and flip this
JARVIS_AUTH=subscription
# ANTHROPIC_API_KEY=sk-ant-...

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8377

# Telegram front-end. Get a token from @BotFather. Bot stays OFF until both are set.
# Your numeric user id: message @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Seconds before an unanswered destructive-action confirmation auto-denies
JARVIS_CONFIRM_TIMEOUT=120
JARVIS_MAX_TURNS=25
